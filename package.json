{
  "name": "random-googlemap",
  "private": true,
  "scripts": {
    "docs:html": "node scripts/docs-report/index.js",
    "lint": "node scripts/lint-report.js",
    "lint:raw": "npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:types",
    "lint:js": "eslint --ext .js . --max-warnings 0 --rulesdir eslint-rules",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0",
    "lint:html": "htmlhint \"**/*.html\" --ignore \"**/reports/**,**/node_modules/**\"",
    "lint:types": "tsc -p tsconfig.json",
    "test:vitest": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=reports/vitest-report.json",
    "test:vitest:watch": "vitest",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:cypress": "node scripts/run-cypress.js",
    "test:cypress:open": "node scripts/run-cypress.js open",
    "test:perf": "node scripts/perf-check.js",
    "test:load": "node scripts/load-test.js",
    "test:security": "node scripts/security-check.js",
    "test:report": "node scripts/test-report.js",
    "test:gate": "node scripts/test-gate.js",
    "test:all": "node scripts/test-all.js",
    "test:all:report": "npm run test:all",
    "quality:all": "node scripts/quality-all.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.11.30",
    "@vitest/coverage-v8": "^4.0.16",
    "autocannon": "^7.12.0",
    "chrome-launcher": "^1.1.0",
    "cypress": "^15.8.1",
    "eslint": "^8.57.0",
    "eslint-plugin-jsdoc": "^61.5.0",
    "htmlhint": "^1.1.4",
    "lighthouse": "^11.7.1",
    "mochawesome": "^7.1.4",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-order": "^6.0.4",
    "typescript": "^5.5.4",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "cookie": "0.7.2",
    "qs": "6.14.1"
  }
}
